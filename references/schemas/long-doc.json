{
  "$comment": "A cover poster, then chapters. Each chapter is a number, a short heading, and a narrow column. Do not open with a summary of the summary.",
  "type": "object",
  "required": ["title", "place", "year", "thesis", "chapters"],
  "properties": {
    "title": { "type": "string", "minLength": 2, "maxLength": 48 },
    "kicker": { "type": "string", "maxLength": 80 },
    "place": { "type": "string", "minLength": 2, "maxLength": 40 },
    "year": { "type": "string", "minLength": 4, "maxLength": 12 },
    "thesis": { "type": "string", "minLength": 40, "maxLength": 400 },
    "chapters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["index", "heading", "paragraphs"],
        "properties": {
          "index": { "type": "string", "minLength": 2, "maxLength": 4 },
          "heading": { "type": "string", "minLength": 2, "maxLength": 80 },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 40, "maxLength": 900 }
          },
          "source": { "type": "string", "maxLength": 160 }
        }
      }
    }
  }
}
