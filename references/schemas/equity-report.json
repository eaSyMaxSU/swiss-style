{
  "$comment": "A thesis, three figures, a source-backed table, catalysts, and risks. A missing price is [DATA NEEDED: price], never an invented quote.",
  "type": "object",
  "required": ["name", "ticker", "place", "date", "thesis", "metrics", "table_title", "rows", "source", "catalysts", "risks"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "ticker": { "type": "string", "minLength": 1, "maxLength": 12 },
    "place": { "type": "string", "minLength": 2, "maxLength": 40 },
    "date": { "type": "string", "minLength": 4, "maxLength": 24 },
    "thesis": { "type": "string", "minLength": 40, "maxLength": 400 },
    "quote": { "type": "string", "maxLength": 40 },
    "metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "minLength": 1, "maxLength": 16 },
          "label": { "type": "string", "minLength": 1, "maxLength": 32 }
        }
      }
    },
    "table_title": { "type": "string", "minLength": 2, "maxLength": 60 },
    "rows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["label", "value", "note"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "value": { "type": "string", "minLength": 1, "maxLength": 24 },
          "note": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "source": { "type": "string", "minLength": 4, "maxLength": 160 },
    "catalysts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 20, "maxLength": 240 }
    },
    "risks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 20, "maxLength": 240 }
    }
  }
}
