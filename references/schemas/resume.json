{
  "$comment": "Two pages. Each role bullet is an action, the scope, and a result that can be checked. Dates sit in the right columns. Do not add a third page by shrinking type.",
  "type": "object",
  "required": ["name", "role", "place", "contact", "summary", "roles", "education", "skills"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 48 },
    "role": { "type": "string", "minLength": 2, "maxLength": 60 },
    "place": { "type": "string", "minLength": 2, "maxLength": 40 },
    "year": { "type": "string", "maxLength": 12 },
    "contact": { "type": "string", "minLength": 4, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 40, "maxLength": 400 },
    "roles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["index", "org", "title", "start", "end", "place", "points"],
        "properties": {
          "index": { "type": "string", "minLength": 2, "maxLength": 4 },
          "org": { "type": "string", "minLength": 2, "maxLength": 60 },
          "title": { "type": "string", "minLength": 2, "maxLength": 60 },
          "start": { "type": "string", "minLength": 4, "maxLength": 12 },
          "end": { "type": "string", "minLength": 2, "maxLength": 12 },
          "place": { "type": "string", "minLength": 2, "maxLength": 40 },
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 20, "maxLength": 220 }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["school", "credential", "years", "place"],
        "properties": {
          "school": { "type": "string", "minLength": 2, "maxLength": 80 },
          "credential": { "type": "string", "minLength": 2, "maxLength": 80 },
          "years": { "type": "string", "minLength": 4, "maxLength": 24 },
          "place": { "type": "string", "minLength": 2, "maxLength": 40 }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 2, "maxLength": 32 }
    }
  }
}
