{
  "$comment": "Versions are the display lines. Notes are short facts. Do not decorate a release with a badge or a chip.",
  "type": "object",
  "required": ["product", "place", "versions"],
  "properties": {
    "product": { "type": "string", "minLength": 2, "maxLength": 48 },
    "place": { "type": "string", "minLength": 2, "maxLength": 40 },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["index", "number", "date", "notes"],
        "properties": {
          "index": { "type": "string", "minLength": 2, "maxLength": 4 },
          "number": { "type": "string", "minLength": 1, "maxLength": 16 },
          "date": { "type": "string", "minLength": 4, "maxLength": 24 },
          "notes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 8, "maxLength": 220 }
          }
        }
      }
    }
  }
}
