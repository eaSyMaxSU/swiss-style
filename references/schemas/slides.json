{
  "$comment": "One assertion per slide, set large and flush left. At most four support lines. The rest of the slide is empty paper.",
  "type": "object",
  "required": ["title", "place", "year", "slides"],
  "properties": {
    "title": { "type": "string", "minLength": 2, "maxLength": 48 },
    "place": { "type": "string", "minLength": 2, "maxLength": 40 },
    "year": { "type": "string", "minLength": 4, "maxLength": 12 },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["index", "assertion"],
        "properties": {
          "index": { "type": "string", "minLength": 2, "maxLength": 4 },
          "assertion": { "type": "string", "minLength": 8, "maxLength": 140 },
          "support": { "type": "string", "maxLength": 280 },
          "points": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "minLength": 2, "maxLength": 140 }
          }
        }
      }
    }
  }
}
