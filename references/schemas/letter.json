{
  "$comment": "One page of correspondence. The recipient's name is the display line. The body is a narrow column. No letterhead ornament.",
  "type": "object",
  "required": ["sender", "recipient", "place", "date", "subject", "paragraphs", "close"],
  "properties": {
    "sender": { "type": "string", "minLength": 2, "maxLength": 80 },
    "sender_contact": { "type": "string", "maxLength": 120 },
    "recipient": { "type": "string", "minLength": 2, "maxLength": 80 },
    "place": { "type": "string", "minLength": 2, "maxLength": 40 },
    "date": { "type": "string", "minLength": 4, "maxLength": 40 },
    "subject": { "type": "string", "minLength": 2, "maxLength": 120 },
    "paragraphs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 40, "maxLength": 700 }
    },
    "close": { "type": "string", "minLength": 2, "maxLength": 40 }
  }
}
