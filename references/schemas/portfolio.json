{
  "$comment": "Three to six pages of work. Alternate the photograph or geometric block from right to left. Each case has a year and a place. No icon row.",
  "type": "object",
  "required": ["name", "place", "year", "intro", "cases"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 48 },
    "place": { "type": "string", "minLength": 2, "maxLength": 40 },
    "year": { "type": "string", "minLength": 4, "maxLength": 12 },
    "intro": { "type": "string", "minLength": 40, "maxLength": 320 },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["index", "title", "year", "place", "body"],
        "properties": {
          "index": { "type": "string", "minLength": 2, "maxLength": 4 },
          "title": { "type": "string", "minLength": 2, "maxLength": 48 },
          "year": { "type": "string", "minLength": 4, "maxLength": 12 },
          "place": { "type": "string", "minLength": 2, "maxLength": 40 },
          "body": { "type": "string", "minLength": 30, "maxLength": 500 }
        }
      }
    }
  }
}
