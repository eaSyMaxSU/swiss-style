{
  "$comment": "A screen page, not a PDF. The name is a poster. Sections stay on the 12-column grid until the viewport is narrower than 721px, where each block spans the width and stays flush left.",
  "type": "object",
  "required": ["name", "place", "year", "lead", "work_heading", "work_body", "contact_heading", "contact_body"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 48 },
    "place": { "type": "string", "minLength": 2, "maxLength": 40 },
    "year": { "type": "string", "minLength": 4, "maxLength": 12 },
    "lead": { "type": "string", "minLength": 20, "maxLength": 280 },
    "work_heading": { "type": "string", "minLength": 2, "maxLength": 40 },
    "work_body": { "type": "string", "minLength": 20, "maxLength": 400 },
    "contact_heading": { "type": "string", "minLength": 2, "maxLength": 40 },
    "contact_body": { "type": "string", "minLength": 8, "maxLength": 200 }
  }
}
